  "components": {
    "schemas": {
      "DemoCloseBody": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Reason",
            "default": "user_closed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DemoCloseBody"
      },
      "DemoCreateBody": {
        "properties": {
          "index_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Index Key"
          },
          "reference_image_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Reference Image Id"
          },
          "modification_text": {
            "type": "string",
            "maxLength": 1000,
            "title": "Modification Text",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index_key",
          "reference_image_id"
        ],
        "title": "DemoCreateBody"
      },
      "DemoFeedbackBody": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Id"
          },
          "expected_round_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Round Id"
          },
          "shown_image_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Shown Image Ids"
          },
          "accepted_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Ids"
          },
          "rejected_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rejected Ids"
          },
          "feedback_text": {
            "type": "string",
            "maxLength": 1000,
            "title": "Feedback Text",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "expected_round_id",
          "shown_image_ids"
        ],
        "title": "DemoFeedbackBody"
      },
      "DemoRetrieveBody": {
        "properties": {
          "top_k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 12
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DemoRetrieveBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
